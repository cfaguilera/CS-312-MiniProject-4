<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="A simple community blog for sharing stories and ideas." />
    <title>Blogging For All</title>
    <link rel="stylesheet" href="/styles.css" />
    <script src="/script.js" defer></script>
  </head>
  <body>
    <!-- Site header -->
    <header class="site-header">
      <a class="logo" href="/">Blogging For All</a>
      <button id="theme-toggle" class="themeChangeButton" type="button">
        Dark mode
      </button>
    </header>

    <!-- Main content -->
    <main>
      <section class="main-content">
        <p class="headerMain">Stories · Ideas · Community</p>
        <h1>Share what is on your mind.</h1>
        <p class="intro">
          Read posts from the community or publish a story of your own.
        </p>
      </section>
      <br>

      <!-- Create a post here -->
      <h2>Create a New Post</h2>

      <br>
      <form class="post-form" action="/posts" method="POST">
        <div>
            <label for="creator">Your name</label>
            <input type="text" id="creator" name="creator" required />
        </div>
        <div>
            <label for="title">Blog title</label>
            <input type="text" id="title" name="title" required />
        </div>
        <div>
            <label for="content">Blog post</label>
            <textarea id="content" name="content" required rows="6"></textarea>
        </div>
        <button type="submit" class="postButton">Create Post</button>
      </form>

      <section class="posts-section">
        <br>
        <!-- Display all posts if any, using EJS -->
        <h2>Blog posts</h2>

        <% if (posts.length === 0) { %>
          <p>No posts yet.</p>
        <% } else { %>
            <% posts.forEach((post) => { %>
                <article class="post-card">
                    <h3><%= post.title %></h3>
                    <p> By <strong><%= post.creator %></strong> on <%= post.createdAt.toLocaleString() %></p>
                    <p><%= post.content %></p>

                    <div class="post-actions">
                      <form action="/posts/<%= post.id %>/edit" method="GET">
                        <button class="edit-button" type="submit">Edit</button>
                      </form>
                      <form action="/posts/<%= post.id %>/delete" method="POST">
                        <button class="delete-button" type="submit">Delete</button>
                      </form>
                    </div>
                </article>
            <% }); %>
        <% } %>
      </section>
    </main>



    <!-- Website footer -->
    <footer>
      <p>&copy; <span id="year"></span> Blogging For All</p>
    </footer>
  </body>
</html>

